{
  "manifest_version": 3,
  "name": "Focus Gate — study only",
  "version": "1.1.0",
  "description": "Asks “What are you here for?” and only opens the sites that task needs. Logs your time, warns you, and keeps opportunity-hunting in a box.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "alarms",
    "notifications",
    "idle",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "gate.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "incognito": "spanning",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-brain-dump": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Alt+B"
      },
      "description": "Open the brain dump side panel"
    }
  }
}